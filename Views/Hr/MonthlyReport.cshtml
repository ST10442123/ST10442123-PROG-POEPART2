@model IEnumerable<CMCS1.Models.Claim>
@using System.Linq

@{
    ViewData["Title"] = "HR Monthly Report";

    var selectedYear = (int)(ViewBag.SelectedYear ?? DateTime.Today.Year);
    var selectedMonth = (int)(ViewBag.SelectedMonth ?? DateTime.Today.Month);

    var totalClaims = Model.Count();
    var totalHours = totalClaims > 0 ? Model.Sum(c => c.HoursWorked) : 0;
    var totalAmount = totalClaims > 0 ? Model.Sum(c => c.TotalAmount) : 0;
    var uniqueLecturers = totalClaims > 0 ? Model.Select(c => c.LecturerName).Distinct().Count() : 0;

    var monthName = new DateTime(selectedYear, selectedMonth, 1).ToString("MMMM yyyy");
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-11">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-secondary text-white text-center rounded-top-4 py-3">
                    <h3 class="mb-0">
                        <i class="bi bi-bar-chart-line-fill"></i> HR Monthly Report - @monthName
                    </h3>
                </div>

                <div class="card-body p-4">

                    @* FILTER FORM *@
                    <div class="mb-4">
                        <form asp-action="MonthlyReport" method="get" class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-calendar"></i> Year
                                </label>
                                <input type="number" name="year" value="@selectedYear" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-calendar-event"></i> Month (1-12)
                                </label>
                                <input type="number" name="month" value="@selectedMonth" min="1" max="12" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100 mb-2">
                                    <i class="bi bi-funnel"></i> Apply
                                </button>
                                <a asp-action="MonthlyReport" class="btn btn-outline-secondary w-100">
                                    <i class="bi bi-arrow-counterclockwise"></i> This Month
                                </a>
                            </div>
                            <div class="col-md-3 text-md-end text-center">
                                <a asp-action="ExportCsv"
                                   asp-route-year="@selectedYear"
                                   asp-route-month="@selectedMonth"
                                   class="btn btn-outline-success w-100">
                                    <i class="bi bi-filetype-csv"></i> Download CSV
                                </a>
                            </div>
                        </form>
                    </div>

                    @* SUMMARY CARDS *@
                    <div class="mb-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="fw-bold text-muted mb-1">
                                            <i class="bi bi-check2-circle"></i> Approved Claims
                                        </div>
                                        <div class="fs-4 fw-bold">@totalClaims</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="fw-bold text-muted mb-1">
                                            <i class="bi bi-clock-history"></i> Total Hours
                                        </div>
                                        <div class="fs-4 fw-bold">@totalHours</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="fw-bold text-muted mb-1">
                                            <i class="bi bi-cash-coin"></i> Total Amount (R)
                                        </div>
                                        <div class="fs-4 fw-bold">
                                            @string.Format("{0:N2}", totalAmount)
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="fw-bold text-muted mb-1">
                                            <i class="bi bi-person-lines-fill"></i> Unique Lecturers
                                        </div>
                                        <div class="fs-4 fw-bold">@uniqueLecturers</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* TABLE *@
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info text-center" role="alert">
                            <i class="bi bi-info-circle"></i>
                            No approved claims found for @monthName.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light border-bottom">
                                    <tr class="text-center">
                                        <th><i class="bi bi-person-circle"></i> Lecturer</th>
                                        <th><i class="bi bi-calendar3"></i> Date Submitted</th>
                                        <th><i class="bi bi-clock-history"></i> Hours</th>
                                        <th><i class="bi bi-cash-coin"></i> Rate (R)</th>
                                        <th><i class="bi bi-calculator"></i> Total (R)</th>
                                        <th><i class="bi bi-chat-left-text"></i> Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in Model)
                                    {
                                        <tr class="text-center">
                                            <td class="fw-semibold">@claim.LecturerName</td>
                                            <td>@claim.DateSubmitted.ToString("yyyy-MM-dd")</td>
                                            <td>@claim.HoursWorked</td>
                                            <td>@string.Format("{0:N2}", claim.HourlyRate)</td>
                                            <td class="fw-semibold">@string.Format("{0:N2}", claim.TotalAmount)</td>
                                            <td class="text-start">@claim.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="card-footer bg-light text-center py-3 rounded-bottom-4">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i>
                        Use this report and CSV export for payroll and record keeping.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
