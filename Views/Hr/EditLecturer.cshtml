@model CMCS1.Models.EditLecturerViewModel

@{
    ViewData["Title"] = "Edit Lecturer Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark text-center rounded-top-4 py-3">
                    <h3 class="mb-0">
                        <i class="bi bi-pencil-square"></i> Edit Lecturer Details
                    </h3>
                </div>

                <div class="card-body p-4">
                    <form asp-action="EditLecturer" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control form-control-lg" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control form-control-lg" readonly />
                            <div class="form-text">
                                Email/login is shown for reference and cannot be changed here.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control form-control-lg" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-success btn-lg px-4 me-2">
                                <i class="bi bi-check-circle-fill"></i> Save Changes
                            </button>
                            <a asp-action="Lecturers" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="bi bi-arrow-left-circle"></i> Back
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light text-center py-3 rounded-bottom-4">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i>
                        Only basic lecturer profile fields are editable from this screen.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
