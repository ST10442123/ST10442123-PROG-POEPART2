@model IEnumerable<CMCS1.Models.Claim>
@using System.Linq

@{
    ViewData["Title"] = "Review Pending Claims";

    var totalClaims = Model.Count();
    var totalHours = totalClaims > 0 ? Model.Sum(c => c.HoursWorked) : 0;
    var totalAmount = totalClaims > 0 ? Model.Sum(c => c.TotalAmount) : 0;
    var averageHours = totalClaims > 0 ? totalHours / totalClaims : 0;

    // read current filter values from query for sticky inputs
    var currentLecturer = Context.Request.Query["searchLecturer"].ToString();
    var currentFrom = Context.Request.Query["fromDate"].ToString();
    var currentTo = Context.Request.Query["toDate"].ToString();
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-11">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center rounded-top-4 py-3">
                    <h3 class="mb-0">
                        <i class="bi bi-clipboard-check"></i> Pending Claims - Verification
                    </h3>
                </div>

                <div class="card-body p-4">

                    @* FILTER BAR *@
                    <div class="mb-4">
                        <form asp-action="Review" method="get" class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-person-search"></i> Lecturer Name
                                </label>
                                <input type="text"
                                       name="searchLecturer"
                                       value="@currentLecturer"
                                       class="form-control"
                                       placeholder="Search by lecturer name..." />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-calendar-event"></i> From Date
                                </label>
                                <input type="date"
                                       name="fromDate"
                                       value="@currentFrom"
                                       class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-calendar-event-fill"></i> To Date
                                </label>
                                <input type="date"
                                       name="toDate"
                                       value="@currentTo"
                                       class="form-control" />
                            </div>
                            <div class="col-md-2 text-md-start text-center">
                                <button type="submit" class="btn btn-primary w-100 mb-2">
                                    <i class="bi bi-funnel"></i> Apply
                                </button>
                                <a asp-action="Review" class="btn btn-outline-secondary w-100">
                                    <i class="bi bi-arrow-counterclockwise"></i> Clear
                                </a>
                            </div>
                        </form>
                    </div>

                    @* SUMMARY PANEL *@
                    @if (Model.Any())
                    {
                        <div class="mb-4">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body text-center">
                                            <div class="fw-bold text-muted mb-1">
                                                <i class="bi bi-list-check"></i> Total Pending Claims
                                            </div>
                                            <div class="fs-4 fw-bold">@totalClaims</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body text-center">
                                            <div class="fw-bold text-muted mb-1">
                                                <i class="bi bi-clock-history"></i> Total Hours
                                            </div>
                                            <div class="fs-4 fw-bold">@totalHours</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body text-center">
                                            <div class="fw-bold text-muted mb-1">
                                                <i class="bi bi-cash-coin"></i> Total Amount (R)
                                            </div>
                                            <div class="fs-4 fw-bold">
                                                @string.Format("{0:N2}", totalAmount)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body text-center">
                                            <div class="fw-bold text-muted mb-1">
                                                <i class="bi bi-graph-up"></i> Average Hours / Claim
                                            </div>
                                            <div class="fs-4 fw-bold">
                                                @string.Format("{0:N1}", averageHours)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @* MAIN TABLE *@
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info text-center" role="alert">
                            <i class="bi bi-info-circle"></i>
                            No pending claims found for the selected filters.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light border-bottom">
                                    <tr class="text-center">
                                        <th><i class="bi bi-person-circle"></i> Lecturer</th>
                                        <th><i class="bi bi-calendar3"></i> Date Submitted</th>
                                        <th><i class="bi bi-clock-history"></i> Hours</th>
                                        <th><i class="bi bi-cash-coin"></i> Rate (R)</th>
                                        <th><i class="bi bi-calculator"></i> Total (R)</th>
                                        <th><i class="bi bi-chat-left-text"></i> Notes</th>
                                        <th><i class="bi bi-file-earmark-text"></i> Document</th>
                                        <th><i class="bi bi-gear"></i> Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in Model)
                                    {
                                        <tr class="text-center">
                                            <td class="fw-semibold">@claim.LecturerName</td>
                                            <td>@claim.DateSubmitted.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@claim.HoursWorked</td>
                                            <td>@string.Format("{0:N2}", claim.HourlyRate)</td>
                                            <td class="fw-semibold">@string.Format("{0:N2}", claim.TotalAmount)</td>
                                            <td class="text-start">@claim.Notes</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(claim.UploadedFileName))
                                                {
                                                    <a href="~/uploads/@claim.UploadedFileName"
                                                       class="btn btn-outline-secondary btn-sm"
                                                       target="_blank">
                                                        <i class="bi bi-file-earmark-pdf"></i> View
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No file</span>
                                                }
                                            </td>
                                            <td>
                                                <form asp-action="Approve" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@claim.Id" />
                                                    <button type="submit"
                                                            class="btn btn-success btn-sm px-3"
                                                            title="Approve Claim">
                                                        <i class="bi bi-check-circle-fill"></i> Approve
                                                    </button>
                                                </form>

                                                <form asp-action="Reject" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@claim.Id" />
                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm px-3"
                                                            title="Reject Claim">
                                                        <i class="bi bi-x-circle-fill"></i> Reject
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="card-footer bg-light text-center py-3 rounded-bottom-4">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i>
                        Use the filters to focus on specific lecturers or date ranges. Coordinators and Managers can approve or reject claims here.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>



